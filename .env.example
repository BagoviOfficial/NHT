# Northern Highways Transporters - Environment Configuration Example
# Copy to .env and customize for your environment.

# Django Security
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL is required in production)
DB_NAME=parcel_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Optional Offline Development Fallback Only (Requires DEBUG=True; strictly prohibited in production)
USE_SQLITE=False

# Security Settings for Production (HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Demo Seeding Guard
ENABLE_DEMO_SEED=False
CREATE_DEMO_ADMIN=False
